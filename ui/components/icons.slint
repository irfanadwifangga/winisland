// Ikon digambar dari Rectangle (tanpa Path: Path di software renderer butuh feature
// tambahan dan menambah dependensi). Segitiga didekati dengan strip vertikal 1 px
// yang tingginya menurun.

export component PlayIcon inherits Rectangle {
    in property <brush> icon-color: white;
    width: 12px;
    height: 14px;

    for i in 12: Rectangle {
        x: i * 1px;
        width: 1px;
        height: 14px * (12 - i) / 12;
        y: (14px - self.height) / 2;
        background: root.icon-color;
    }
}

// Ikon pause: dua batang vertikal.
export component PauseIcon inherits Rectangle {
    in property <brush> icon-color: white;
    width: 12px;
    height: 14px;

    Rectangle {
        x: 1px;
        width: 4px;
        height: parent.height;
        background: root.icon-color;
    }

    Rectangle {
        x: 7px;
        width: 4px;
        height: parent.height;
        background: root.icon-color;
    }
}

// Ikon next: segitiga menghadap kanan dan satu batang di kanannya.
export component NextIcon inherits Rectangle {
    in property <brush> icon-color: white;
    width: 12px;
    height: 14px;

    for i in 9: Rectangle {
        x: i * 1px;
        width: 1px;
        height: 14px * (9 - i) / 9;
        y: (14px - self.height) / 2;
        background: root.icon-color;
    }

    Rectangle {
        x: 10px;
        width: 2px;
        height: parent.height;
        background: root.icon-color;
    }
}

// Ikon previous: satu batang di kiri dan segitiga menghadap kiri.
export component PrevIcon inherits Rectangle {
    in property <brush> icon-color: white;
    width: 12px;
    height: 14px;

    Rectangle {
        x: 0px;
        width: 2px;
        height: parent.height;
        background: root.icon-color;
    }

    for i in 9: Rectangle {
        x: 3px + i * 1px;
        width: 1px;
        height: 14px * (i + 1) / 9;
        y: (14px - self.height) / 2;
        background: root.icon-color;
    }
}

// Ikon speaker audio dengan status suara / mute.
export component SpeakerIcon inherits Rectangle {
    in property <brush> icon-color: white;
    in property <bool> muted: false;
    width: 14px;
    height: 14px;

    // Kotak belakang speaker
    Rectangle {
        x: 0px;
        y: (parent.height - 6px) / 2;
        width: 3px;
        height: 6px;
        background: root.icon-color;
    }

    // Kerucut speaker
    for i in 4: Rectangle {
        x: 3px + i * 1px;
        width: 1px;
        height: 6px + i * 2px;
        y: (parent.height - self.height) / 2;
        background: root.icon-color;
    }

    // Gelombang suara (bila tidak mute)
    if !root.muted: Rectangle {
        x: 9px;
        y: (parent.height - 8px) / 2;
        width: 1.5px;
        height: 8px;
        border-radius: 0.75px;
        background: root.icon-color;
    }

    if !root.muted: Rectangle {
        x: 12px;
        y: (parent.height - 12px) / 2;
        width: 1.5px;
        height: 12px;
        border-radius: 0.75px;
        background: root.icon-color;
    }

    // Garis mute (bila mute)
    if root.muted: Rectangle {
        x: 9px;
        y: (parent.height - 10px) / 2;
        width: 2px;
        height: 10px;
        background: #f87171;
    }
}

// Ikon play: segitiga didekati dengan 12 strip vertikal setinggi menurun (tanpa elemen
// Path, karena Path di software renderer butuh feature tambahan dan menambah dependensi).
component PlayIcon inherits Rectangle {
    width: 12px;
    height: 14px;

    for i in 12: Rectangle {
        x: i * 1px;
        width: 1px;
        height: 14px * (12 - i) / 12;
        y: (14px - self.height) / 2;
        background: #b0b0b0;
    }
}

// Ikon pause: dua batang vertikal.
component PauseIcon inherits Rectangle {
    width: 12px;
    height: 14px;

    Rectangle {
        x: 1px;
        width: 4px;
        height: parent.height;
        background: #b0b0b0;
    }

    Rectangle {
        x: 7px;
        width: 4px;
        height: parent.height;
        background: #b0b0b0;
    }
}

export component MainWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 140px;
    preferred-height: 4px;

    in-out property <bool> expanded: false;
    in-out property <string> track-title: "";
    in-out property <string> track-artist: "";
    // true bila ada sesi media aktif; false menyembunyikan ikon status
    in-out property <bool> has-media: false;
    // true bila sedang diputar (ikon play), false bila dijeda (ikon pause)
    in-out property <bool> playing: false;
    callback hover-changed(bool);

    property <bool> hovered: area.has-hover;
    changed hovered => { root.hover-changed(root.hovered); }

    area := TouchArea {
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.expanded ? 8px : 0px;
            width: root.expanded ? 360px : 140px;
            height: root.expanded ? 100px : 4px;
            border-radius: min(self.height / 2, 28px);
            background: black;
            clip: true;

            animate width, height, y {
                duration: 250ms;
                easing: ease-out;
            }

            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                alignment: center;

                Text {
                    text: root.track-title;
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    overflow: elide;
                    visible: root.expanded;
                }

                Text {
                    text: root.track-artist;
                    color: #b0b0b0;
                    font-size: 13px;
                    horizontal-alignment: center;
                    overflow: elide;
                    visible: root.expanded;
                }
            }

            // ikon status pemutaran di bawah teks, rata tengah
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 12px;
                width: 12px;
                height: 14px;
                visible: root.expanded && root.has-media;

                PlayIcon { visible: root.playing; }
                PauseIcon { visible: !root.playing; }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("tray.png");
    tooltip: "winisland";

    in-out property <bool> autostart: false;

    callback toggle();
    callback toggle-autostart(bool);
    callback quit();

    clicked => { toggle(); }

    Menu {
        MenuItem {
            title: "Show / Hide";
            activated => { toggle(); }
        }

        MenuItem {
            title: root.autostart ? "Autostart: On" : "Autostart: Off";
            activated => { toggle-autostart(!root.autostart); }
        }

        MenuItem {
            title: "Quit";
            activated => { quit(); }
        }
    }
}

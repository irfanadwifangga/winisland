export component MainWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 140px;
    preferred-height: 4px;

    in-out property <bool> expanded: false;
    callback hover-changed(bool);

    property <bool> hovered: area.has-hover;
    changed hovered => { root.hover-changed(root.hovered); }

    area := TouchArea {
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 0px;
            width: root.expanded ? 360px : 140px;
            height: root.expanded ? 100px : 4px;
            border-radius: min(self.height / 2, 28px);
            background: black;

            animate width, height { duration: 250ms; easing: ease-out; }
        }
    }
}
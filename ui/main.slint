export component MainWindow inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 140px;
    preferred-height: 4px;

    in-out property <bool> expanded: false;
    in-out property <string> track-title: "";
    in-out property <string> track-artist: "";
    callback hover-changed(bool);

    property <bool> hovered: area.has-hover;
    changed hovered => { root.hover-changed(root.hovered); }

    area := TouchArea {
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.expanded ? 8px : 0px;
            width: root.expanded ? 360px : 140px;
            height: root.expanded ? 100px : 4px;
            border-radius: min(self.height / 2, 28px);
            background: black;
            clip: true;

            animate width, height, y {
                duration: 250ms;
                easing: ease-out;
            }

            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                alignment: center;

                Text {
                    text: root.track-title;
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    overflow: elide;
                    visible: root.expanded;
                }

                Text {
                    text: root.track-artist;
                    color: #b0b0b0;
                    font-size: 13px;
                    horizontal-alignment: center;
                    overflow: elide;
                    visible: root.expanded;
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("tray.png");
    tooltip: "winisland";

    in-out property <bool> autostart: false;

    callback toggle();
    callback toggle-autostart(bool);
    callback quit();

    clicked => { toggle(); }

    Menu {
        MenuItem {
            title: "Show / Hide";
            activated => { toggle(); }
        }

        MenuItem {
            title: root.autostart ? "Autostart: On" : "Autostart: Off";
            activated => { toggle-autostart(!root.autostart); }
        }

        MenuItem {
            title: "Quit";
            activated => { quit(); }
        }
    }
}

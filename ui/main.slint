// Ikon digambar dari Rectangle (tanpa Path: Path di software renderer butuh feature
// tambahan dan menambah dependensi). Segitiga didekati dengan strip vertikal 1 px
// yang tingginya menurun.
component PlayIcon inherits Rectangle {
    in property <brush> icon-color: white;
    width: 12px;
    height: 14px;

    for i in 12: Rectangle {
        x: i * 1px;
        width: 1px;
        height: 14px * (12 - i) / 12;
        y: (14px - self.height) / 2;
        background: root.icon-color;
    }
}

// Ikon pause: dua batang vertikal.
component PauseIcon inherits Rectangle {
    in property <brush> icon-color: white;
    width: 12px;
    height: 14px;

    Rectangle {
        x: 1px;
        width: 4px;
        height: parent.height;
        background: root.icon-color;
    }

    Rectangle {
        x: 7px;
        width: 4px;
        height: parent.height;
        background: root.icon-color;
    }
}

// Ikon next: segitiga menghadap kanan dan satu batang di kanannya.
component NextIcon inherits Rectangle {
    in property <brush> icon-color: white;
    width: 12px;
    height: 14px;

    for i in 9: Rectangle {
        x: i * 1px;
        width: 1px;
        height: 14px * (9 - i) / 9;
        y: (14px - self.height) / 2;
        background: root.icon-color;
    }

    Rectangle {
        x: 10px;
        width: 2px;
        height: parent.height;
        background: root.icon-color;
    }
}

// Ikon previous: satu batang di kiri dan segitiga menghadap kiri.
component PrevIcon inherits Rectangle {
    in property <brush> icon-color: white;
    width: 12px;
    height: 14px;

    Rectangle {
        x: 0px;
        width: 2px;
        height: parent.height;
        background: root.icon-color;
    }

    for i in 9: Rectangle {
        x: 3px + i * 1px;
        width: 1px;
        height: 14px * (i + 1) / 9;
        y: (14px - self.height) / 2;
        background: root.icon-color;
    }
}

// Tombol bulat dengan latar saat di-hover. `@children` (ikon) digambar di bawah
// TouchArea supaya klik selalu sampai ke TouchArea.
component ControlButton inherits Rectangle {
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: touch.has-hover ? #2a2a2a : transparent;

    @children

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Item tab navigasi pill dengan highlight saat aktif atau di-hover.
component TabItem inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: 22px;
    border-radius: 11px;
    background: root.active ? #2c2c2c : (touch.has-hover ? #1a1a1a : transparent);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;

        Text {
            text: root.text;
            color: root.active ? white : (touch.has-hover ? #d0d0d0 : #757575);
            font-size: 11px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Satu baris notifikasi untuk ditampilkan di pill. Semua field sudah berupa teks siap
// tampil (disusun di Rust), jadi Slint tidak perlu memformat apa pun.
export struct NotifRow {
    // nama aplikasi, ditambah jumlah bila beberapa notifikasi digabung (mis. "WhatsApp ×3")
    header: string,
    // kosong bila judul sama dengan nama aplikasi
    title: string,
    // kosong bila sakelar privasi "tampilkan isi" mati (bawaan)
    body: string,
    // umur notifikasi, mis. "2 min ago"
    age: string,
}

export component MainWindow inherits Window {
    default-font-family: "SF Pro Display, Segoe UI Variable Display, Segoe UI, sans-serif";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    preferred-width: 140px;
    preferred-height: 4px;

    // --- model 3-state (Idle -> Peek -> Expanded) ---
    // true bila kursor mengarah ke strip tepi atas (mode intip tipis dengan jam)
    in-out property <bool> peek: false;
    // true bila pill diklik dan terbuka penuh menjadi dynamic island
    in-out property <bool> expanded: false;
    // teks jam digital untuk mode peek dan home (mis. "13:05")
    in-out property <string> clock-text: "12:00";
    // teks tanggal lokal untuk home (mis. "Thu, 22 Oct")
    in-out property <string> date-text: "Thu, 22 Oct";

    // statistik sistem (Langkah 13)
    in-out property <int> cpu-pct: 0;
    in-out property <int> ram-pct: 0;
    in-out property <bool> has-battery: false;
    in-out property <int> battery-pct: 0;
    in-out property <bool> battery-charging: false;

    in-out property <string> track-title: "";
    in-out property <string> track-artist: "";
    // true bila ada sesi media aktif; false menyembunyikan tombol kontrol
    in-out property <bool> has-media: false;
    // true bila sedang diputar (tombol menampilkan pause), false bila dijeda (menampilkan play)
    in-out property <bool> playing: false;

    // --- notifikasi (diisi dari Rust setiap pill dibuka)
    // jumlah notifikasi mentah di Action Center (sebelum pengelompokan); 0 menyembunyikan lencana
    in-out property <int> notif-total: 0;
    // kelompok notifikasi terbaru (paling banyak 5)
    in-out property <[NotifRow]> notifs: [];
    // indeks kelompok yang sedang tampil
    in-out property <int> notif-index: 0;
    // true: pill menampilkan notifikasi; false: menampilkan media
    in-out property <bool> show-notifs: false;

    // --- model tab dan ukuran dinamis (Langkah 12)
    // 0: Home, 1: Calendar, 2: Timer, 3: Mail. Diingat di memori.
    in-out property <int> active-tab: 0;

    // Dimensi target pill saat peek atau expanded sesuai tab aktif dan konten
    property <length> target-pill-w:
        root.expanded ? (
            root.active-tab == 0 ? 380px :
            root.active-tab == 1 ? 380px :
            root.active-tab == 2 ? 360px :
            360px
        ) : (root.peek ? 175px : 140px);

    property <length> target-pill-h:
        root.expanded ? (
            root.active-tab == 0 ? (root.show-notifs ? 135px : (root.has-media ? 165px : 120px)) :
            root.active-tab == 1 ? 180px :
            root.active-tab == 2 ? 140px :
            140px
        ) : (root.peek ? 32px : 4px);

    // Ukuran jendela yang diminta (dalam piksel logis). Slint adalah sumber kebenaran.
    // Saat peek atau expanded, tinggi jendela mencakup celah floating 8 px dari tepi atas.
    out property <length> requested-width: root.target-pill-w;
    out property <length> requested-height: (root.expanded || root.peek) ? (root.target-pill-h + 8px) : 4px;

    callback hover-changed(bool);
    callback expand-clicked();
    callback play-pause();
    callback skip-next();
    callback skip-previous();
    callback request-window-resize();

    property <bool> hovered: area.has-hover;
    changed hovered => { root.hover-changed(root.hovered); }

    // Setiap kali pill dibuka, mulai dari tampilan notifikasi bila tidak ada media tetapi
    // ada notifikasi; bila ada media atau tidak ada notifikasi, mulai dari tampilan media.
    changed expanded => {
        if (!root.expanded) {
            root.show-notifs = false;
            root.notif-index = 0;
        }
    }

    // Minta Rust menyesuaikan ukuran jendela saat tab berganti
    // Minta Rust menyesuaikan ukuran jika status tampilan notifikasi detail berubah
    changed show-notifs => {
        if (root.active-tab == 0 && root.expanded) {
            root.request-window-resize();
        }
    }

    changed active-tab => {
        root.request-window-resize();
    }

    // Minta Rust menyesuaikan ukuran jika status media berubah saat di tab Home
    changed has-media => {
        if (root.active-tab == 0 && root.expanded) {
            root.request-window-resize();
        }
    }

    area := TouchArea {
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (root.expanded || root.peek) ? 8px : 0px;
            width: root.target-pill-w;
            height: root.target-pill-h;
            border-radius: min(self.height / 2, 28px);
            background: black;
            clip: true;

            animate width, height, y {
                duration: 250ms;
                easing: ease-out;
            }

            // --- mode Peek (hover, belum diklik): tampilkan jam dan indikator ringkas ---
            if root.peek && !root.expanded: Rectangle {
                HorizontalLayout {
                    alignment: center;
                    spacing: 10px;

                    // ikon musik kecil bila sedang memutar lagu
                    if root.has-media && root.playing: Rectangle {
                        width: 9px;
                        height: 11px;
                        y: (parent.height - self.height) / 2;
                        PlayIcon {
                            icon-color: #4ade80;
                            width: 9px;
                            height: 11px;
                        }
                    }

                    Text {
                        text: root.clock-text;
                        color: white;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    // titik merah indikator notifikasi aktif di Action Center
                    if root.notif-total > 0: Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: #d64545;
                        y: (parent.height - self.height) / 2;
                    }
                }

                // Klik di mode peek untuk expand penuh ke dynamic island
                TouchArea {
                    clicked => {
                        root.expanded = true;
                        root.expand-clicked();
                    }
                }
            }

            // --- bar tab navigasi (hanya tampil saat expanded) ---
            if root.expanded: HorizontalLayout {
                y: 8px;
                height: 22px;
                alignment: center;
                spacing: 6px;

                TabItem {
                    text: "Home";
                    active: root.active-tab == 0;
                    clicked => { root.active-tab = 0; }
                }

                TabItem {
                    text: "Calendar";
                    active: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }

                TabItem {
                    text: "Timer";
                    active: root.active-tab == 2;
                    clicked => { root.active-tab = 2; }
                }

                TabItem {
                    text: "Mail";
                    active: root.active-tab == 3;
                    clicked => { root.active-tab = 3; }
                }
            }

            // --- konten tab Home (active-tab == 0) ---
            if root.expanded && root.active-tab == 0: Rectangle {
                y: 32px;
                height: parent.height - 32px;

                // --- Tampilan Utama Home (Jam, Tanggal, Stats, Notifikasi 1 baris, Media jika ada) ---
                if !root.show-notifs: VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 4px;
                    padding-bottom: 6px;
                    spacing: 6px;

                    // Baris 1: Jam & Tanggal di kiri, Chip Statistik di kanan
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            alignment: center;
                            spacing: 0px;

                            Text {
                                text: root.clock-text;
                                color: white;
                                font-size: 20px;
                                font-weight: 700;
                            }

                            Text {
                                text: root.date-text;
                                color: #8e8e93;
                                font-size: 11px;
                                font-weight: 500;
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            spacing: 5px;
                            y: (parent.height - self.height) / 2;

                            // Chip CPU
                            Rectangle {
                                height: 22px;
                                border-radius: 6px;
                                background: #1c1c1e;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: "CPU \{root.cpu-pct}%";
                                        color: root.cpu-pct > 80 ? #f87171 : #4ade80;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Chip RAM
                            Rectangle {
                                height: 22px;
                                border-radius: 6px;
                                background: #1c1c1e;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: "RAM \{root.ram-pct}%";
                                        color: root.ram-pct > 85 ? #f87171 : #38bdf8;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Chip Baterai (hanya jika ada baterai)
                            if root.has-battery: Rectangle {
                                height: 22px;
                                border-radius: 6px;
                                background: #1c1c1e;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: root.battery-charging ? "⚡ \{root.battery-pct}%" : "BAT \{root.battery-pct}%";
                                        color: root.battery-charging ? #facc15 : (root.battery-pct <= 20 ? #f87171 : #e2e8f0);
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Baris 2: Satu baris notifikasi terbaru (aplikasi + judul, elide)
                    Rectangle {
                        height: 24px;
                        border-radius: 7px;
                        background: notif_touch.has-hover ? #252528 : #18181a;
                        clip: true;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: space-between;
                            spacing: 6px;

                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                alignment: start;

                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.notif-total > 0 ? #ef4444 : #52525b;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: root.notif-total > 0 ? (
                                        root.notifs.length > 0 ? (
                                            root.notifs[0].title != "" ?
                                                "\{root.notifs[0].header}: \{root.notifs[0].title}" :
                                                root.notifs[0].header
                                        ) : "\{root.notif-total} notifications"
                                    ) : "No new notifications";
                                    color: root.notif-total > 0 ? #e4e4e7 : #71717a;
                                    font-size: 11px;
                                    font-weight: root.notif-total > 0 ? 500 : 400;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }

                            if root.notif-total > 0: Rectangle {
                                width: 18px;
                                height: 16px;
                                border-radius: 8px;
                                background: #ef4444;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: root.notif-total > 99 ? "99+" : "\{root.notif-total}";
                                    color: white;
                                    font-size: 9px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        notif_touch := TouchArea {
                            clicked => {
                                if (root.notif-total > 0) {
                                    root.show-notifs = true;
                                }
                            }
                        }
                    }

                    // Baris 3: Media baris (jika ada sesi media aktif)
                    if root.has-media: Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        background: #141416;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            alignment: space-between;
                            spacing: 8px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;

                                Text {
                                    text: root.track-title;
                                    color: white;
                                    font-size: 12px;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                if root.track-artist != "": Text {
                                    text: root.track-artist;
                                    color: #a1a1aa;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }

                            HorizontalLayout {
                                alignment: end;
                                spacing: 4px;
                                y: (parent.height - self.height) / 2;

                                ControlButton {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 13px;
                                    clicked => { root.skip-previous(); }

                                    PrevIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                ControlButton {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 13px;
                                    clicked => { root.play-pause(); }

                                    PauseIcon {
                                        visible: root.playing;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    PlayIcon {
                                        visible: !root.playing;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                ControlButton {
                                    width: 26px;
                                    height: 26px;
                                    border-radius: 13px;
                                    clicked => { root.skip-next(); }

                                    NextIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }
                }

                // --- Tampilan Detail Notifikasi (saat baris notifikasi atau lencana diklik) ---
                if root.show-notifs: Rectangle {
                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 4px;
                        padding-bottom: 8px;
                        spacing: 4px;

                        // Navigasi kembali ke Home & status halaman
                        HorizontalLayout {
                            alignment: space-between;
                            height: 18px;

                            Rectangle {
                                border-radius: 9px;
                                background: back_touch.has-hover ? #2a2a2a : transparent;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: "← Back to Home";
                                        color: back_touch.has-hover ? white : #a1a1aa;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                back_touch := TouchArea {
                                    clicked => { root.show-notifs = false; }
                                }
                            }

                            if root.notifs.length > 0: Text {
                                text: root.notifs.length > 1 ? "\{root.notif-index + 1} of \{root.notifs.length}" : "";
                                color: #71717a;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        // Kartu notifikasi detail
                        Rectangle {
                            background: #141416;
                            border-radius: 8px;
                            clip: true;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 2px;
                                alignment: center;

                                if root.notifs.length == 0: Text {
                                    text: "No notifications";
                                    color: #71717a;
                                    font-size: 12px;
                                }

                                if root.notifs.length > 0: HorizontalLayout {
                                    alignment: space-between;
                                    spacing: 8px;

                                    Text {
                                        text: root.notifs[root.notif-index].header;
                                        color: #a1a1aa;
                                        font-size: 11px;
                                        font-weight: 600;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: root.notifs[root.notif-index].age;
                                        color: #71717a;
                                        font-size: 10px;
                                    }
                                }

                                if root.notifs.length > 0 && root.notifs[root.notif-index].title != "": Text {
                                    text: root.notifs[root.notif-index].title;
                                    color: white;
                                    font-size: 13px;
                                    font-weight: 700;
                                    overflow: elide;
                                }

                                if root.notifs.length > 0 && root.notifs[root.notif-index].body != "": Text {
                                    text: root.notifs[root.notif-index].body;
                                    color: #b0b0b0;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                            TouchArea {
                                clicked => {
                                    if (root.notifs.length > 0) {
                                        if (root.notif-index + 1 >= root.notifs.length) {
                                            root.notif-index = 0;
                                        } else {
                                            root.notif-index += 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // --- konten tab Calendar (active-tab == 1) ---
            if root.expanded && root.active-tab == 1: VerticalLayout {
                y: 32px;
                height: parent.height - 32px;
                alignment: center;
                spacing: 6px;
                padding: 16px;

                Text {
                    text: "Calendar";
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Month grid arriving in Step 14";
                    color: #888888;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            // --- konten tab Timer (active-tab == 2) ---
            if root.expanded && root.active-tab == 2: VerticalLayout {
                y: 32px;
                height: parent.height - 32px;
                alignment: center;
                spacing: 6px;
                padding: 16px;

                Text {
                    text: "Timer & Stopwatch";
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Stopwatch, countdown & alarm arriving in Step 15";
                    color: #888888;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            // --- konten tab Mail (active-tab == 3) ---
            if root.expanded && root.active-tab == 3: VerticalLayout {
                y: 32px;
                height: parent.height - 32px;
                alignment: center;
                spacing: 6px;
                padding: 16px;

                Text {
                    text: "Mail & Tasks";
                    color: white;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Integration arriving in Step 17";
                    color: #888888;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("tray.png");
    tooltip: "winisland";

    in-out property <bool> autostart: false;
    // true bila isi notifikasi boleh dibaca dan ditampilkan (bawaan: false)
    in-out property <bool> show-notif-body: false;
    // label monitor aktif, mis. "Display: Primary" atau "Display: 2"
    in-out property <string> display-label: "Display: Primary";
    // true bila overlay otomatis disembunyikan saat aplikasi fullscreen aktif
    in-out property <bool> hide-on-fullscreen: true;

    callback toggle();
    callback toggle-autostart(bool);
    callback toggle-notif-body(bool);
    callback cycle-display();
    callback toggle-hide-on-fullscreen(bool);
    callback quit();

    clicked => { toggle(); }

    Menu {
        MenuItem {
            title: "Show / Hide";
            activated => { toggle(); }
        }

        MenuItem {
            title: root.display-label;
            activated => { cycle-display(); }
        }

        MenuItem {
            title: root.autostart ? "Autostart: On" : "Autostart: Off";
            activated => { toggle-autostart(!root.autostart); }
        }

        MenuItem {
            title: root.show-notif-body ? "Notification body: Shown" : "Notification body: Hidden";
            activated => { toggle-notif-body(!root.show-notif-body); }
        }

        MenuItem {
            title: root.hide-on-fullscreen ? "Hide in fullscreen: On" : "Hide in fullscreen: Off";
            activated => { toggle-hide-on-fullscreen(!root.hide-on-fullscreen); }
        }

        MenuItem {
            title: "Quit";
            activated => { quit(); }
        }
    }
}

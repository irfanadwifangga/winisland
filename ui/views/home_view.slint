import { PlayIcon, PauseIcon, NextIcon, PrevIcon } from "../components/icons.slint";
import { ControlButton } from "../components/buttons.slint";
import { NotifRow } from "../models.slint";

export component HomeView inherits VerticalLayout {
    in property <string> clock-text;
    in property <string> date-text;
    in property <int> cpu-pct;
    in property <int> ram-pct;
    in property <bool> has-gpu;
    in property <int> gpu-pct;
    in property <bool> has-battery;
    in property <int> battery-pct;
    in property <bool> battery-charging;
    in property <int> notif-total;
    in property <[NotifRow]> notifs;
    in property <bool> has-media;
    in property <string> track-title;
    in property <string> track-artist;
    in property <bool> playing;

    callback notif-clicked();
    callback play-pause();
    callback skip-next();
    callback skip-previous();

    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 6px;
    spacing: 6px;

    // Baris 1: Jam & Tanggal di kiri, Chip Statistik di kanan
    HorizontalLayout {
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 0px;

            Text {
                text: root.clock-text;
                color: white;
                font-size: 20px;
                font-weight: 700;
            }

            Text {
                text: root.date-text;
                color: #8e8e93;
                font-size: 11px;
                font-weight: 500;
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 5px;
            y: (parent.height - self.height) / 2;

            // Chip CPU
            Rectangle {
                height: 22px;
                border-radius: 6px;
                background: #1c1c1e;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: "CPU \{root.cpu-pct}%";
                        color: root.cpu-pct > 80 ? #f87171 : #4ade80;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            // Chip RAM
            Rectangle {
                height: 22px;
                border-radius: 6px;
                background: #1c1c1e;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: "RAM \{root.ram-pct}%";
                        color: root.ram-pct > 85 ? #f87171 : #38bdf8;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            // Chip GPU (hanya jika ada GPU yang terdeteksi)
            if root.has-gpu: Rectangle {
                height: 22px;
                border-radius: 6px;
                background: #1c1c1e;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: "GPU \{root.gpu-pct}%";
                        color: root.gpu-pct > 80 ? #f87171 : #a78bfa;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            // Chip Baterai (hanya jika ada baterai)
            if root.has-battery: Rectangle {
                height: 22px;
                border-radius: 6px;
                background: #1c1c1e;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.battery-charging ? "⚡ \{root.battery-pct}%" : "BAT \{root.battery-pct}%";
                        color: root.battery-charging ? #facc15 : (root.battery-pct <= 20 ? #f87171 : #e2e8f0);
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Baris 2: Satu baris notifikasi terbaru (aplikasi + judul, elide). Klik membuka tampilan notifikasi detail.
    Rectangle {
        height: 24px;
        border-radius: 7px;
        background: notif_touch.has-hover ? #252528 : #18181a;
        clip: true;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            alignment: space-between;
            spacing: 6px;

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                alignment: start;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.notif-total > 0 ? #ef4444 : #52525b;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.notif-total > 0 ? (
                        root.notifs.length > 0 ? (
                            root.notifs[0].title != "" ?
                                "\{root.notifs[0].header}: \{root.notifs[0].title}" :
                                root.notifs[0].header
                        ) : "\{root.notif-total} notifications"
                    ) : "No new notifications";
                    color: root.notif-total > 0 ? #e4e4e7 : #71717a;
                    font-size: 11px;
                    font-weight: root.notif-total > 0 ? 500 : 400;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            if root.notif-total > 0: Rectangle {
                width: 18px;
                height: 16px;
                border-radius: 8px;
                background: #ef4444;
                y: (parent.height - self.height) / 2;

                Text {
                    text: root.notif-total > 99 ? "99+" : "\{root.notif-total}";
                    color: white;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        notif_touch := TouchArea {
            clicked => {
                if (root.notif-total > 0) {
                    root.notif-clicked();
                }
            }
        }
    }

    // Baris 3: Media baris (jika ada sesi media aktif)
    if root.has-media: Rectangle {
        height: 34px;
        border-radius: 8px;
        background: #141416;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            alignment: space-between;
            spacing: 8px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;

                Text {
                    text: root.track-title;
                    color: white;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.track-artist != "": Text {
                    text: root.track-artist;
                    color: #a1a1aa;
                    font-size: 10px;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 4px;
                y: (parent.height - self.height) / 2;

                ControlButton {
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    clicked => { root.skip-previous(); }

                    PrevIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                ControlButton {
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    clicked => { root.play-pause(); }

                    PauseIcon {
                        visible: root.playing;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    PlayIcon {
                        visible: !root.playing;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                ControlButton {
                    width: 26px;
                    height: 26px;
                    border-radius: 13px;
                    clicked => { root.skip-next(); }

                    NextIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
    }
}
